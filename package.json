{
  "name": "vue-stack-tabs",
  "version": "1.4.0",
  "private": false,
  "type": "module",
  "description": "Vue 3 multi-tab manager built on Vue Router with iframe-like tab isolation: per-tab component scope, stack-based forward/backward navigation, keep-alive page caching, scroll position memory, i18n and a Nuxt 3/4 module.",
  "files": [
    "src/lib",
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-stack-tabs.es.js"
    },
    "./iframe-bridge": {
      "types": "./dist/iframe-bridge.d.ts",
      "import": "./dist/iframe-bridge.mjs"
    },
    "./nuxt": {
      "types": "./dist/nuxt/module.d.ts",
      "import": "./dist/nuxt/module.mjs"
    },
    "./dist/style.css": "./dist/style.css",
    "./dist/vue-stack-tabs.css": "./dist/vue-stack-tabs.css"
  },
  "peerDependencies": {
    "nuxt": "^3.0.0 || ^4.0.0",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "peerDependenciesMeta": {
    "nuxt": {
      "optional": true
    }
  },
  "main": "./dist/vue-stack-tabs.es.js",
  "module": "./dist/vue-stack-tabs.es.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jktantan/vue-stack-tabs.git"
  },
  "keywords": [
    "vue",
    "vue3",
    "vue-router",
    "router",
    "tabs",
    "tab",
    "tab-panel",
    "multi-tab",
    "tabs-router",
    "keep-alive",
    "cache",
    "iframe",
    "nuxt",
    "nuxt3",
    "nuxt-module",
    "navigation",
    "vue-component",
    "typescript"
  ],
  "author": "tantan",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/jktantan/vue-stack-tabs/issues"
  },
  "homepage": "https://github.com/jktantan/vue-stack-tabs#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean:ports": "node -e \"const { execSync } = require('child_process'); try { if (process.platform === 'win32') { execSync('netstat -ano | findstr \":5173\" | findstr \"LISTENING\"').toString().split('\\n').forEach(line => { const pid = line.trim().split(/\\s+/)[4]; if (pid) try { execSync(`taskkill /F /PID ${pid}`, { stdio: 'ignore' }); } catch(e) {} }); execSync('netstat -ano | findstr \":5174\" | findstr \"LISTENING\"').toString().split('\\n').forEach(line => { const pid = line.trim().split(/\\s+/)[4]; if (pid) try { execSync(`taskkill /F /PID ${pid}`, { stdio: 'ignore' }); } catch(e) {} }); } else { execSync('lsof -ti:5173 | xargs kill -9 || true', { shell: '/bin/bash' }); execSync('lsof -ti:5174 | xargs kill -9 || true', { shell: '/bin/bash' }); } console.log('✅ 端口清理完成'); } catch(e) { console.log('✅ 端口已经空闲或清理完成'); }\"",
    "docs:dev": "run-p docs:dev:docs docs:dev:demo",
    "docs:dev:docs": "vitepress dev docs",
    "docs:dev:demo": "vite --config vite.config.docs-demo.ts",
    "docs:build": "vitepress build docs && vite build --config vite.config.docs-demo.ts",
    "dev": "vite  --host ",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lib:build": "vite --config vite.config.lib.ts build && vite --config vite.config.iframe-bridge.ts build && vite --config vite.config.nuxt.ts build && node -e \"const fs=require('fs');fs.copyFileSync('dist/vue-stack-tabs.css','dist/style.css');fs.rmSync('dist/src',{recursive:true,force:true});\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "defu": "^6.1.7",
    "mitt": "^3.0.1",
    "nostics": "^1.3.0",
    "throttle-debounce": "^5.0.2",
    "vue-i18n-lite": "^1.0.2"
  },
  "devDependencies": {
    "@ctrl/tinycolor": "^4.2.1",
    "@element-plus/icons-vue": "^2.3.2",
    "@eslint/js": "^10.0.1",
    "@floating-ui/core": "^1.8.0",
    "@floating-ui/dom": "^1.8.0",
    "@floating-ui/utils": "^0.2.12",
    "@mdit/plugin-tasklist": "^1.1.3",
    "@popperjs/core": "^2.11.8",
    "@rushstack/eslint-patch": "^1.16.1",
    "@tsconfig/node26": "^26.0.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.5",
    "@types/throttle-debounce": "^5.0.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/compiler-core": "^3.5.43",
    "@vue/compiler-dom": "^3.5.43",
    "@vue/devtools-api": "^8.2.1",
    "@vue/devtools-kit": "^8.2.1",
    "@vue/devtools-shared": "^8.2.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/reactivity": "^3.5.43",
    "@vue/runtime-core": "^3.5.43",
    "@vue/runtime-dom": "^3.5.43",
    "@vue/shared": "^3.5.43",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^14.4.0",
    "@vueuse/shared": "^14.4.0",
    "async-validator": "^4.2.5",
    "birpc": "^4.2.0",
    "dayjs": "^1.11.23",
    "element-plus": "^2.14.7",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.6",
    "hookable": "^6.1.2",
    "lodash-es": "^4.18.1",
    "lodash-unified": "^1.0.3",
    "memoize-one": "^6.0.0",
    "normalize-wheel-es": "^1.2.0",
    "normalize.css": "^8.0.1",
    "npm-run-all2": "^9.0.3",
    "perfect-debounce": "^2.1.0",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.105.1",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.4",
    "vite-plugin-dts": "5.0.3",
    "vite-plugin-package-version": "^1.1.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.13"
  }
}
