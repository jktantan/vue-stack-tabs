{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue", "test/**/*"],
  "exclude": [],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "ignoreDeprecations": "6.0",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      // 自引用（如 src/lib/nuxt/runtime/plugin.ts）在类型检查时解析到源码，
      // 不要依赖 dist/：dist 不入库，CI 干净 checkout 中不存在。
      "vue-stack-tabs": ["./src/lib/index.ts"]
    }
  }
}
